diff --git a/exp/trainer/train_loop.py b/exp/trainer/train_loop.py
index 52183184e..5e5d30a4e 100755
--- a/exp/trainer/train_loop.py
+++ b/exp/trainer/train_loop.py
@@ -163,3 +163,53 @@ def transformer_mixed_precision_train_loop(
         raise RuntimeError(f"Training failed: {e}") from e
     finally:
         [_plugin.stop() for _plugin in plugins]
+
+
+def transformer_infer_loop(
+    model, data_loader, epochs, device, optimizer,
+    iterations=2, lr=0.001, plugins=[], zero_grad_mode=None,
+):
+    """Phase 1a: prefill only, use_cache=False, no grad."""
+    import os
+    [p.start() for p in plugins]
+    time.sleep(2)
+    try:
+        model.to(device)
+        model.eval()
+        with torch.no_grad():
+            for epoch in range(epochs):
+                for index, batch in enumerate(data_loader):
+                    [p.step() for p in plugins]
+                    batch = {k: v.to(device) for k, v in batch.items()
+                             if k != "labels"}
+                    if batch["input_ids"].numel() == 0 or \
+                       batch["input_ids"].shape[-1] == 0:
+                        continue
+                    model(**batch, use_cache=False)
+                    if index == iterations:
+                        break
+    except Exception as e:
+        raise RuntimeError(f"Inference failed: {e}") from e
+    finally:
+        [p.stop() for p in plugins]
+
+
+def conv_infer_loop(
+    model, data_loader, epochs, device, optimizer,
+    iterations=None, lr=0.001, plugins=[], zero_grad_mode=None,
+):
+    [p.start() for p in plugins]
+    model.to(device)
+    model.eval()
+    try:
+        with torch.no_grad():
+            for epoch in range(epochs):
+                for index, (inputs, labels) in enumerate(data_loader):
+                    [p.step() for p in plugins]
+                    model(inputs.to(device))
+                    if iterations is not None and index >= iterations:
+                        break
+    except Exception as e:
+        raise RuntimeError(f"Inference failed: {e}") from e
+    finally:
+        [p.stop() for p in plugins]
